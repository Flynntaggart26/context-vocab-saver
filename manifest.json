{
  "manifest_version": 3,
  "name": "Context Vocab Saver",
  "short_name": "VocabSaver",
  "version": "0.2.0",
  "description": "Double-click any English word to save it with its real sentence. Quiz yourself later with spaced repetition — words learned in context.",
  "minimum_chrome_version": "116",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "Context Vocab Saver",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },

  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": false
  },

  "background": {
    "service_worker": "src/background.js"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],

  "permissions": ["storage", "contextMenus", "alarms", "notifications"],

  "host_permissions": ["https://api.mymemory.translated.net/*"],
  "web_accessible_resources": []
}
